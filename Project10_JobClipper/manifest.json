{
  "manifest_version": 3,
  "name": "Job Clipper",
  "version": "1.0.0",
  "description": "Clip job listings and track applications in a private local Kanban board.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications"],
  "action": {
    "default_title": "Job Clipper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
